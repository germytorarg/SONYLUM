    "@remotion/fonts": "4.0.537",
    "@remotion/noise": "4.0.537",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@types/react": "19.1.8",
    "typescript": "5.9.3"
  }
}
