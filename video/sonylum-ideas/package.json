{
  "name": "sonylum-ideas",
  "version": "1.0.0",
  "private": true,
  "description": "SONYLUM \u2014 'Las ideas tambi\u00e9n tienen vida'. Motion graphic editorial 9:16, 30s, Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SonylumIdeas out/sonylum-ideas.mp4 --codec=h264 --crf=16",
    "still": "remotion still SonylumIdeas out/still.png --frame=60",
    "typecheck": "tsc --noEmit",
    "web": "node tools/gen_web_assets.mjs && esbuild src/web.tsx --bundle --minify --format=esm --target=es2022 --loader:.png=dataurl --loader:.jpg=dataurl --loader:.woff2=dataurl --define:process.env.NODE_ENV='\"production\"' --outfile=web/player.js",
    "capture": "npm run web && node tools/build_capture.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/noise": "4.0.537",
    "@remotion/player": "4.0.537",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  }
}
